# copy to .env and fill in
CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx   # free key: https://cloakbrowser.dev/free (1 browser at a time)
API_KEY=change-me-long-random          # REQUIRED when HOST is not 127.0.0.1
HOST=0.0.0.0                           # default 127.0.0.1
PORT=3456
HEADLESS=1                             # 1 = no window (server). Unset = visible window (your PC)
# PROXY=http://user:pass@host:port     # optional; a datacenter IP may trigger captchas
# PROFILE_DIR=./profile
# LOGIN_STATE=./login.json
